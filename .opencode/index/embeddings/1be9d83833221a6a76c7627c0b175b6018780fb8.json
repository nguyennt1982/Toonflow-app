{"file":"src/routes/setting/vendorConfig/getVendorList.ts","chunks":[{"line":1,"text":"import express from \"express\";\nimport { success } from \"@/lib/responseFormat\";\nimport u from \"@/utils\";\nconst router = express.Router();\n\nexport default router.post(\"/\", async (req, res) => {\n  const data = await u.db(\"o_vendorConfig\").select(\"*\");\n\n  const list = (\n    await Promise.all(\n      data.map(async (item) => {\n        const vendor = u.vendor.getVendor(item.id!);\n        if (!vendor) {\n          await u.db(\"o_vendorConfig\").where(\"id\", item.id).delete();\n          return null\n        };\n        return {\n          ...item,\n          inputValues: JSON.parse(item.inputValues ?? \"{}\"),\n          models: await u.vendor.getModelList(item.id!),\n          code: u.vendor.getCode(item.id!),\n          description: vendor.description ?? \"\",\n          inputs: vendor.inputs,\n          author: vendor.author,\n          name: vendor.name,\n          version: vendor.version ?? \"1.0\",\n        };\n      }),\n    )\n  ).filter((i) => Boolean(i));\n\n  list.sort((a, b) => (a!.id === \"toonflow\" ? -1 : b!.id === \"toonflow\" ? 1 : 0));\n  res.status(200).send(success(list));\n});\n","embedding":[-0.021704576909542084,0.05787823721766472,0.0016111858421936631,0.07409531623125076,-0.001667573000304401,0.026248661801218987,-0.021039456129074097,0.015419740229845047,0.05758717283606529,-0.020656339824199677,-0.04716474562883377,-0.02988666668534279,0.0006351604824885726,-0.06625160574913025,-0.01612073741853237,0.08042779564857483,-0.04670391231775284,-0.04600318893790245,-0.06555809080600739,-0.07783142477273941,0.08426665514707565,0.09391297399997711,0.013190530240535736,0.03982650488615036,-0.014527503401041031,-0.025702383369207382,0.04200814664363861,-0.06522505730390549,-0.06123709678649902,-0.021087048575282097,0.01197147835046053,-0.011167926713824272,-0.08145982772111893,0.009856708347797394,-0.0021675955504179,-0.02076786942780018,-0.031549