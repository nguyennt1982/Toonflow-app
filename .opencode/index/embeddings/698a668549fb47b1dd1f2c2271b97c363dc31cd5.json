{"file":"src/routes/setting/modelMap/deletePrompt.ts","chunks":[{"line":1,"text":"import express from \"express\";\nimport { error, success } from \"@/lib/responseFormat\";\nimport u from \"@/utils\";\nimport { z } from \"zod\";\nimport { validateFields } from \"@/middleware/middleware\";\nimport fs from \"fs/promises\";\nimport path from \"path\";\n\nconst router = express.Router();\n\nexport default router.post(\n  \"/\",\n  validateFields({\n    path: z.string(),\n  }),\n  async (req, res) => {\n    const { path: filePath } = req.body;\n\n    const modelPromptRoot = u.getPath([\"modelPrompt\"]);\n\n    // 路径隧穿检测\n    const resolvedRoot = path.resolve(modelPromptRoot);\n    const resolvedFile = path.resolve(modelPromptRoot, filePath);\n    if (!resolvedFile.startsWith(resolvedRoot + path.sep)) {\n      return res.status(400).send(error(\"非法路径\"));\n    }\n\n    // 文件不存在则报错\n    try {\n      await fs.access(resolvedFile);\n    } catch {\n      return res.status(404).send(error(\"文件不存在\"));\n    }\n\n    await fs.unlink(resolvedFile);\n    res.status(200).send(success(\"删除成功\"));\n  },\n);\n","embedding":[-0.08982236683368683,0.042701080441474915,-0.01945492997765541,0.035496193915605545,0.051967501640319824,-0.006526940502226353,-0.06789269298315048,0.12792542576789856,0.036493003368377686,0.04498077929019928,-0.03315414488315582,-0.023761434480547905,0.0016485218657180667,0.03289071097970009,0.01732625998556614,0.0356445349752903,-0.06925657391548157,-0.034323155879974365,-0.011377168819308281,0.03809865564107895,0.08071362227201462,0.062022749334573746,0.05285369232296944,0.02589346654713154,0.003756856545805931,-0.10191873461008072,-0.04096056893467903,-0.0015743969706818461,-0.05114820599555969,-0.011486411094665527,0.04067585617303848,0.05446140840649605,-0.10256068408489227,0.013112535700201988,0.01881236955523491,0.07769683748483658,0.021346624940633774,-0.11470489203929901,-0.013457860797643661,-0.0954069197177887,0.03279885649681091,0.10309900343418121,0.0