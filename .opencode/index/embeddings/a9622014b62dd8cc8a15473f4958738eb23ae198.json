时反过来\n- **一击定胜负** — 终极对决的最后一击给足仪式感：蓄力（升格特写）→出招（闪切快推）→命中（大特写+冲击留白）→结果（缓拉全景）。四拍完整呈现","embedding":[-0.0811670795083046,0.0069338311441242695,0.007806746289134026,-0.05782177671790123,-0.03599322587251663,-0.007477040868252516,-0.0021496317349374294,-0.04982374235987663,-0.021846048533916473,-0.021557079628109932,0.0942048579454422,-0.02234019711613655,0.02149813435971737,-0.03819994628429413,-0.038822732865810394,0.04310194402933121,-0.06574978679418564,0.10462084412574768,-0.027824003249406815,0.06492406129837036,-0.04507821798324585,-0.12026036530733109,-0.0139755355194211,-0.02286341041326523,0.028120500966906548,0.06928934901952744,-0.030710814520716667,0.10459072887897491,-0.017986206337809563,-0.039922699332237244,-0.044467855244874954,0.10295387357473373,0.01339113898575306,-0.0009053602116182446,0.06127052381634712,0.03689374774694443,-0.00805104710161686,0.05491377040743828,-0.0371059887111187,0.08642668277025223,-0.049623459577560425,-0.0019617057405412197,0.02975989133119583,-0.05328724905848503,-0.003210071474313736,0.023515736684203148,-0.019952917471528053,-0.022893184795975685,-0.08193067461252213,-0.07246522605419159,0.0025296530220657587,0.016054213047027588,-0.027605129405856133,0.07976049929857254,0.026389673352241516,-0.009714108891785145,0.003909284248948097,0.005655771587044001,0.0357455313205719,-0.04943937063217163,-0.023719023913145065,0.027588190510869026,-0.021233772858977318,-0.042927734553813934,-0.03630741685628891,0.018921997398138046,-0.012814466841518879,-0.03141029179096222,-0.03484076261520386,0.002146456390619278,-0.028317579999566078,0.017534082755446434,-0.021011224016547203,-0.07629010826349258,0.009247057139873505,0.036933429539203644,-0.011275630444288254,0.019086139276623726,-0.0850263312458992,-0.14721494913101196,-0.03288049250841141,0.03901364281773567,0.09207192063331604,-0.05697397515177727,-0.13977979123592377,0.056757211685180664,-0.06395528465509415,-0.028061319142580032,0.1377265751361847,-0.04254637286067009,0.0627895