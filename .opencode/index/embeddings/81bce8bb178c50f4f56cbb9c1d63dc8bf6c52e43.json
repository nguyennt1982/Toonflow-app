{"file":"src/routes/production/editImage/uploadImage.ts","chunks":[{"line":1,"text":"import express from \"express\";\nimport u from \"@/utils\";\nimport { success, error } from \"@/lib/responseFormat\";\nimport { validateFields } from \"@/middleware/middleware\";\nimport { z } from \"zod\";\nimport { v4 as uuid } from \"uuid\";\nconst router = express.Router();\n\n// 文件上传（支持图片、音频、视频）\nexport default router.post(\n  \"/\",\n  validateFields({\n    projectId: z.number(),\n    scriptId: z.number(),\n    base64Data: z.string(),\n  }),\n  async (req, res) => {\n    const { base64Data, projectId, scriptId } = req.body;\n    function getExtFromBase64(base64Data: string): string {\n      const mime = base64Data.match(/^data:([^;]+);base64,/)?.[1] ?? \"\";\n      const mimeMap: Record<string, string> = {\n        // 图片\n        \"image/jpeg\": \"jpeg\",\n        \"image/jpg\": \"jpg\",\n        \"image/png\": \"png\",\n        // 音频\n        \"audio/mpeg\": \"mp3\",\n        \"audio/mp3\": \"mp3\",\n        \"audio/wav\": \"wav\",\n        // 视频\n        \"video/mp4\": \"mp4\",\n        \"video/webm\": \"webm\",\n      };\n      return mimeMap[mime] ?? \"bin\";\n    }\n    const ext = getExtFromBase64(base64Data);\n    if (![\"jpeg\", \"jpg\", \"png\"].includes(ext)) {\n      return res.status(400).send(error(\"不支持的文件类型\"));\n    }\n    const savePath = `/${projectId}/imageFlow/${scriptId}/${uuid()}.${ext}`;\n\n    await u.oss.writeFile(savePath, Buffer.from(base64Data.match(/base64,([A-Za-z0-9+/=]+)/)[1] ?? \"\", \"base64\"));\n    const url = await u.oss.getSmallImageUrl(savePath);\n    res.status(200).send(success(url));\n  },\n);\n","embedding":[-0.014345092698931694,0.05750538781285286,-0.023156894370913506,-0.013703443109989166,0.07306533306837082,-0.03888017311692238,-0.050292301923036575,0.10749390721321106,0.009029136970639229,0.02197265811264515,-0.007779007311910391,-0.06688864529132843,0.030051222071051598,0.00849099364131689,0.012627446092665195,0.0155523540452