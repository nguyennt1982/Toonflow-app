{"file":"scripts/generate-routes-map.ts","chunks":[{"line":1,"text":"import fs from \"fs\";\nimport path from \"path\";\n\nconst INDEX = path.join(process.cwd(), \".opencode\", \"index\", \"code-index.json\");\nconst OUT = path.join(process.cwd(), \"docs\", \"business\", \"02-routes-map.md\");\n\nconst MODULES: Record<string, string> = {\n  agents: \"Agent conversation memory management (clear/get memory).\",\n  artStyle: \"Art-style presets CRUD + AI style-prompt extraction.\",\n  assets: \"Assets center: CRUD `o_assets`/`o_image`, audio assets, clip upload, material lists, polling.\",\n  assetsGenerate: \"Trigger AI generation of asset images (fire-and-forget + task row), prompt polishing, cancel.\",\n  common: \"Generic helpers (get big image from thumbnail).\",\n  cornerScape: \"Role→audio voice matching (AI picks audio per character).\",\n  general: \"Dashboard: project statistics, single project get/update.\",\n  login: \"JWT login (`o_user` + `o_setting.tokenKey`). Only unauthenticated endpoint.\",\n  modelSelect: \"List/detail AI models from enabled vendors.\",\n  novel: \"Novel (chapters) CRUD; `novel/event/*` = chapter event extraction + event CRUD.\",\n  other: \"Maintenance: delete all data, app version.\",\n  production: \"Production pipeline: flow data, storyboard CRUD, image-flow editor, workbench video tracks.\",\n  project: \"Project CRUD, director manual, visual manual (skill `.md` on disk).\",\n  script: \"Script CRUD, export, AI asset extraction, polling.\",\n  scriptAgent: \"Script-agent plan read/write (`o_agentWorkData`) + script upsert.\",\n  setting: \"App settings (see grouped list below).\",\n  task: \"Task center: paginated `o_tasks` queries, categories, details.\",\n  test: \"Dev stub.\",\n};\n\nconst SETTING_GROUPS: Record<string, string> = {\n  about: \"App update check / installer download.\",\n  agentDeploy: \"Per-agent model deployment (`o_agentDeploy`), simple/advanced mode.\",\n  dbConfig: \"DB info (`sqlite_master`), clear tables/data, export/import JSON.\",\n  dev: \"Toggle AI dev-tool.\",\n  fileManagement: \"Open a folder in the OS.\",\n  loginConfig: \"User/password management.\",\n  memoryConfig: \"Agent memory tuning (upserts `o_setting` keys).\",\n  modelMap: \"Bind image/video models to video-prompt template files; prompt CRUD.\",\n  promptManage: \"Prompt template CRUD (`o_prompt`).\",\n  skillManagement: \"Skill `.md` files on disk + `o_skillList`.\",\n  vendorConfig: \"Vendor CRUD (code compiled in vm2 sandbox), enable/disable, model tests.\",\n};\n\nfunction main() {\n  if (!fs.existsSync(INDEX)) {\n    console.error(\"Missing code index. Run `yarn index:generate` first.\");\n    process.exit(1);\n  }\n  const index = JSON.parse(fs.readFileSync(INDEX, \"utf8\"));\n  const routes: Record<string, string> = index.routes;\n\n  const byModule = new Map<string, string[]>();\n  for (const [file, apiPath] of Object.entries(routes) as [string, string][]) {\n    const seg = apiPath.split(\"/\")[2] ?? \"\";\n    const arr = byModule.get(seg) ?? [];\n    arr.push(`\\`${apiPath}\\` ← ${file}`);\n    byModule.set(seg, arr);\n  }\n\n  const out: string[] = [];\n  out.push(\"# Toonflow REST API Map\");\n  out.push(\"\");\n  out.push(`- ${Object.keys(routes).length} endpoints, auto-registered from \\`src/routes/**/*.ts\\` (see \\`src/core.ts\\`).`);\n  out.push(\"- All endpoints require JWT (`Authorization: Bearer <token>`, from `o_setting.tokenKey`) except `/api/login/login`.\");\n  out.push(\"- Response envelope: `{code: 200|400, data, message}` via `src/lib/responseFormat.ts`.\");\n  out.push(\"- Validation: zod `validateFields` middleware (400 on failure, Chinese messages).\");\n  out.push(\"- Generated by `yarn docs:routes`. Do not edit by hand.\");\n  out.push(\"\");\n\n  const sortedModules = [...byModule.keys()].sort();\n  for (const mod of sortedModules) {\n    const items = byModule.get(mod)!.sort();\n    out.push(`## \\`/api/${mod}\\``);\n    out.push(\"\");\n    out.push(MODULES[mod] ?? \"\");\n    out.push(\"\");\n    for (const it of items) out.push(`- ${it}`);\n    out.push(\"\");\n  }\n\n  out.push(\"## `/api/setting` groups\");\n  out.push(\"\");\n  for (const [g, desc] of Object.entries(SETTING_GROUPS)) {\n    const items = (byModule.get(\"setting\") ?? []).filter((l) => l.includes(`/api/setting/${g}/`));\n    if (items.length === 0) continue;\n    out.push(`### ${g} — ${desc}`);\n    out.push(\"\");\n    for (const it of items.sort()) out.push(`- ${it}`);\n    out.push(\"\");\n  }\n\n  fs.mkdirSync(path.dirname(OUT), { recursive: true });\n  fs.writeFileSync(OUT, out.join(\"\\n\"), \"utf8\");\n  console.log(`Wrote ${OUT}`);\n}\n","embedding":[-0.01842084527015686,-0.0005756914615631104,-0.12581665813922882,0.0020587854087352753,0.03382066264748573,-0.01934371143579483,0.011594940908253193,0.09455122798681259,0.0037726694718003273,0.031381938606500626,0.026838457211852074,-0.04107867553830147,0.0545429065823555,-0.0264444462954998,0.0017984593287110329,0.04870307445526123,-0.08221476525068283,-0.012372341006994247,-0.03195439651608467,-0.07004041969776154,0.05191589146852493,0.061468470841646194,0.09871532768011093,-0.07863734662532806,0.0067341686226427555,0.004596260841935873,0.004040636122226715,-0.02165987901389599,-0.05837970972061157,-0.032722994685173035,0.05808401480317116,0.038740888237953186,-0.0019311854848638177,0.06227278709411621,0.06819456815719604,0.12327950447797775,0.0011374523164704442,-0.10865355283021927,-0.02367563359439373,-0.02928340993821621,0.03502485156059265,0.10268011689186096,-0.06113813444972038,-0.09985006600618362,-0.023364180698990822,-0.07146500796079636,-0.13299977779388428,-0.08161228150129318,0.03938315436244011,0.02526807226240635,-0.13797815144062042,-0.02738766372203827,-0.05142182856798172,0.019905386492609978,0.024994924664497375,0.102613165974617,-0.015652386471629143,-0.0056556458584964275,0.0006476095295511186,-0.02230234071612358,0.027323994785547256,-0.052875153720378876,0.03273635730147362,