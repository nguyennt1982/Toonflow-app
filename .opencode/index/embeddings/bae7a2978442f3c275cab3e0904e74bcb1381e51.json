{"file":"src/routes/production/storyboard/batchDelete.ts","chunks":[{"line":1,"text":"import express from \"express\";\nimport u from \"@/utils\";\nimport { z } from \"zod\";\nimport { error, success } from \"@/lib/responseFormat\";\nimport { validateFields } from \"@/middleware/middleware\";\nconst router = express.Router();\n\nexport default router.post(\n  \"/\",\n  validateFields({\n    ids: z.array(z.number()),\n    projectId: z.number(),\n  }),\n  async (req, res) => {\n    const { ids, projectId } = req.body;\n    if (!ids.length) return res.status(400).send(error(\"请先选择分镜\"));\n    const storyboardDataList = await u.db(\"o_storyboard\").whereIn(\"id\", ids).where(\"projectId\", projectId).select(\"id\", \"track\", \"trackId\", \"flowId\");\n    if (!storyboardDataList.length) return res.status(400).send(error(\"当前选择分镜不存在\"));\n    const flowIds = storyboardDataList.map((i) => i.flowId);\n    const storyBoardIds = storyboardDataList.map((i) => i.id);\n    if (flowIds.length)\n      await u\n        .db(\"o_imageFlow\")\n        .whereIn(\"id\", flowIds as number[])\n        .delete();\n\n    await u.db(\"o_storyboard\").whereIn(\"id\", storyBoardIds).delete();\n    await u.db(\"o_assets2Storyboard\").whereIn(\"storyboardId\", storyBoardIds).delete();\n    res.status(200).send(success({ message: \"视频删除成功\" }));\n  },\n);\n","embedding":[-0.0057301572524011135,0.06106441468000412,-0.0015151405241340399,0.0322689414024353,0.031129175797104836,-0.025999078527092934,-0.012377251870930195,0.018622860312461853,0.05582351237535477,0.011885455809533596,-0.03497368097305298,-0.028840309008955956,0.05562897026538849,-0.012286210432648659,-0.03945557773113251,0.04386737197637558,-0.05572712793946266,-0.05128807574510574,-0.07708338648080826,0.021442025899887085,0.06531216949224472,0.06321171671152115,0.04186873137950897,0.044172804802656174,0.01885472610592842,-0.06317691504955292,0.03387501463294029,-0.02716640569269657,-0.04293982312083244,-0.010200326330959797,0.01725