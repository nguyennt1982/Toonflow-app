{"file":"src/routes/artStyle/editArtStyle.ts","chunks":[{"line":1,"text":"import express from \"express\";\nimport u from \"@/utils\";\nimport { z } from \"zod\";\nimport { v4 as uuidv4 } from \"uuid\";\nimport { success } from \"@/lib/responseFormat\";\nimport { validateFields } from \"@/middleware/middleware\";\nconst router = express.Router();\n\nexport default router.post(\n  \"/\",\n  validateFields({\n    id: z.number(),\n    name: z.string(),\n    fileUrl: z.string(),\n    prompt: z.string(),\n  }),\n  async (req, res) => {\n    const { id, name, fileUrl, prompt } = req.body;\n    const imagePath = `/artStyle/${uuidv4()}.jpg`;\n    const matches = fileUrl.match(/^data:image\\/\\w+;base64,(.+)$/);\n    const realBase64 = matches ? matches[1] : fileUrl;\n    await u.oss.writeFile(imagePath, Buffer.from(realBase64, \"base64\"));\n    await u\n      .db(\"o_artStyle\")\n      .update({\n        name,\n        fileUrl: imagePath,\n        label: name,\n        prompt,\n      })\n      .where(\"id\", id);\n    res.status(200).send(success(\"艺术风格编辑成功\"));\n  },\n);\n","embedding":[-0.04014142230153084,0.09237559884786606,-0.030811797827482224,0.024264005944132805,0.05879165977239609,-0.04429958015680313,-0.019943825900554657,0.0934610366821289,0.02548231929540634,0.027285557240247726,-0.03703681007027626,-0.034388892352581024,0.08380004018545151,0.008111272007226944,-0.016122352331876755,0.035885609686374664,-0.11975711584091187,-0.024296345189213753,-0.03635415434837341,-0.01606454886496067,0.029330456629395485,0.02246732823550701,0.12293518334627151,-0.023510387167334557,0.0014992259675636888,-0.05319744348526001,-0.0007713557570241392,-0.023479187861084938,-0.040816571563482285,-0.03968358412384987,0.07843399792909622,-0.005850387737154961,-0.050116706639528275,0.01988472230732441,-0.0016811201348900795,0.08182737976312637,0.03850584849715233,-0.08424541354179382,-0.004375892225652933,-0.05461946874856949,0.029286235570907593,0.07459254562854767,0.008710559457540