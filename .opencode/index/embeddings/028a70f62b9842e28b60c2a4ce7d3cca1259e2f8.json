{"file":"scripts/generate-data-model.ts","chunks":[{"line":1,"text":"import Database from \"better-sqlite3\";\nimport fs from \"fs\";\nimport path from \"path\";\n\nconst DB_PATH = path.join(process.cwd(), \"data\", \"db2.sqlite\");\nconst OUT = path.join(process.cwd(), \"docs\", \"business\", \"01-data-model.md\");\n\nconst PURPOSES: Record<string, string> = {\n  o_user: \"Login accounts. Seeded with a default admin (see `src/lib/initDB.ts`).\",\n  o_project:\n    \"Project entity (a novel adaptation). Holds projectType, novel info, chosen image/video models, artStyle, directorManual, videoRatio, mode.\",\n  o_artStyle: \"Art-style presets (name, label, prompt, preview image fileUrl in OSS).\",\n  o_agentDeploy:\n    \"Per-agent-key AI model deployment: `key` = agent key (`scriptAgent`, `productionAgent`, `universalAi`, `scriptAgent:decisionAgent`, ...), `modelName` = `<vendorId>:<modelName>`, plus temperature/maxOutputTokens/disabled/type.\",\n  o_setting: \"App-wide key/value settings: `tokenKey` (JWT secret), `agentUseMode` (0 simple / 1 advanced), memory tuning, `switchAiDevTool`, etc.\",\n  o_tasks: \"AI generation task records. `taskClass` groups tasks, `relatedObjects` lists affected ids, `state` = 进行中/成功/失败 (in-flight rows are filtered out of polling endpoints).\",\n  o_prompt: \"Reusable prompt templates (`data`, `useData`).\",\n  o_modelPrompt: \"Binding of an image/video model to a video-prompt template file under `data/modelPrompt/video/*.md`.\",\n  o_novel: \"Novel chapters. `chapterData` = raw novel text, `event`/`eventState` = extraction result from `u.cleanNovel`.\",\n  o_event: \"Extracted chapter events (AI-generated from novel text).\",\n  o_eventChapter: \"Join: event ↔ novel chapter (`eventId`, `novelId`).\",\n  o_script: \"Generated scripts. `content` = the `<scriptItem>` XML; `extractState` tracks asset extraction.\",\n  o_scriptAssets: \"Join: script ↔ asset (`scriptId`, `assetId`).\",\n  o_assets:\n    \"Asset center entries (derived assets, storyboard assets, character/scene/role images). Links to `o_image` via `imageId`; `promptState` tracks prompt generation.\",\n  o_image: \"Image records. `filePath` → OSS, `state` = 生成中/成功/失败, `model`/`resolution`, `errorReason`.\",\n  o_assets2Storyboard: \"Join: storyboard panel ↔ asset (a panel may reuse existing assets).\",\n  o_assetsRole2Audio: \"Join: role asset ↔ matched audio asset (cornerScape voice matching).\",\n  o_storyboard:\n    \"Storyboard panels: prompt, filePath (OSS image), state, track/trackId, `shouldGenerateImage`, videoDesc. Also the derive-asset lineage via `assetsId`-style links.\",\n  o_agentWorkData: \"Agent workspace/plan data: `projectId` + `episodesId` + `key` (storySkeleton, adaptationStrategy, scriptPlan, storyboardTable, ...) → `data` JSON string.\",\n  o_video: \"Generated video records (workbench): filePath, state, videoTrackId, errorReason.\",\n  o_videoTrack: \"Video timeline tracks on the workbench: prompt, duration, selectVideoId, state.\",\n  o_imageFlow: \"Image-flow editor graphs (JSON node graph in `flowData`).\",\n  o_vendorConfig:\n    \"Vendor (LLM provider) config: `id` = vendor id, `inputValues` = baseURL/apiKey/etc, `models` = available models JSON, `enable` flag. Vendor template code lives on disk in `data/vendor/<id>.ts`.\",\n  o_skillList: \"Installed skills registry: name, description, path, md5, embedding (for retrieval), state.\",\n  o_skillAttribution: \"Skill ↔ attribution binding (`skillId`, `attribution` = project/agent scope).\",\n  memories: \"Agent conversation memory. Keyed by `isolationKey` (`projectId:agentType[:episodesId]`); `type` = message|summary; `embedding` = ONNX vector for RAG; `relatedMessageIds` for thread linking.\",\n};\n\nfunction esc(ident: string): string {\n  return JSON.stringify(ident);\n}\n\nfunction main() {\n  const db = new Database(DB_PATH, { readonly: true });\n  const tables = db\n    .prepare(\"select name from sqlite_master where type='table' and name not like 'sqlite_%' order by name\")\n    .all()\n    .map((r: { name: string }) => r.name);\n\n  const out: string[] = [];\n  out.push(\"# Toonflow Data Model (db2.sqlite)\");\n  out.push(\"\");\n  out.push(`- DB file: \\`data/db2.sqlite\\` (knex + better-sqlite3) — **gitignored runtime user data**`);","embedding":[0.0008733740542083979,-0.03935118764638901,-0.09370104968547821,0.010145647451281548,0.02748255245387554,-0.01906140148639679,0.044136613607406616,0.118373341858387,-0.013221735134720802,0.04972149059176445,0.030889825895428658,-0.0681859701871872,0.04652630165219307,-0.05124591663479805,0.0004832611884921789,0.0672900602221489,-0.0768422931432724,-0.00026152640930376947,-0.039200153201818466,-0.008699620142579079,0.04879831150174141,0.009906508959829807,0.09186969697475433,-0.02993696555495262,0.013245861046016216,-0.026188259944319725,0.04584825783967972,0.047329824417829514,-0.06970857828855515,-0.02194330282509327,0.013970475643873215,0.04315883293747902,-0.029952064156532288,0.07924474775791168,0.09415419399738312,0.07836678624153137,0.03963997960090637,-0.12301314622163773,-0.06767337769269943,-0.027071325108408928,0.05315930396318436,0.10530835390090942,-0.04095093533396721,-0.08879145234823227,-0.028272727504372597,-0.04617734253406525,-0.13007600605487823,-0.10040704905986786,0.014192457310855389,0.003570044646039605,-0.16463753581047058,-0.023661216720938683,-0.06172911822795868,0.002502547577023506,0.04216693341732025,0.11147279292345047,0.017844993621110916,0.019946055486798286,-0.025129972025752068,-0.019602583721280098,0.03639346733689308,-0.03947291523218155,0.012122143059968948,-0.015387725085020065,-0.006374157965183258,0.014144820161163807,-0.053823187947273254,0.00008599975262768567,0.058169495314359665,-0.0557762011885643,-0.09684055298566818,0.06944965571165085,-0.08082464337348938,0.016232701018452644,-0.08492524921894073,-0.03519422188401222,0.0467190183699131,0.021763358265161514,-0.016745641827583313,-0.15652166306972504,-0.04806194454431534,-0.04