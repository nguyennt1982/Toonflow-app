{"file":"src/routes/setting/agentDeploy/deployAgentModel.ts","chunks":[{"line":1,"text":"import express from \"express\";\nimport { success } from \"@/lib/responseFormat\";\nimport u from \"@/utils\";\nimport { z } from \"zod\";\nimport { validateFields } from \"@/middleware/middleware\";\nconst router = express.Router();\n\nexport default router.post(\n  \"/\",\n  validateFields({\n    items: z.array(\n      z.object({\n        id: z.number(),\n        name: z.string(),\n        model: z.string(),\n        modelName: z.string(),\n        vendorId: z.string().nullable(),\n        desc: z.string(),\n        temperature: z.number().optional(),\n        maxOutputTokens: z.number().optional(),\n      }),\n    ),\n  }),\n  async (req, res) => {\n    const { items } = req.body;\n    for (const item of items) {\n      const { id, name, model, modelName, vendorId, desc, temperature, maxOutputTokens } = item;\n      await u.db(\"o_agentDeploy\").where({ id }).update({ id, name, model, modelName, vendorId, desc, temperature, maxOutputTokens });\n    }\n    res.status(200).send(success(\"批量配置成功\"));\n  },\n);\n","embedding":[-0.07080718129873276,0.1156105250120163,-0.03130064904689789,0.08637503534555435,0.00878586433827877,-0.022345339879393578,-0.010039808228611946,0.0440090149641037,0.02965250425040722,0.01201822143048048,-0.02465466782450676,-0.0452820286154747,0.0756136029958725,-0.02931184321641922,0.003441708395257592,0.0632283017039299,-0.04201260581612587,-0.050388485193252563,-0.08467250317335129,-0.04745182767510414,0.045733749866485596,0.09711244702339172,0.0036122770980000496,0.03481614962220192,0.00033304281532764435,-0.05275079607963562,-0.011934458278119564,0.0018300471128895879,-0.02201819233596325,0.01906714215874672,-0.007604656741023064,0.005493354983627796,-0.06014573574066162,0.048318278044462204,0.007074541412293911,0.024954937398433685,-0.011980039067566395,-0.09386750310659409,-0.0028227348811924458,-0.004732773173600435,0.053794875741004944,0.06618752