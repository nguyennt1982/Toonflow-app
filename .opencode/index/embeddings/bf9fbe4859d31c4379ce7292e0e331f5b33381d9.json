{"file":"src/routes/setting/modelMap/getImageAndVideoModel.ts","chunks":[{"line":1,"text":"import express from \"express\";\nimport u from \"@/utils\";\nimport { success } from \"@/lib/responseFormat\";\nconst router = express.Router();\n\nexport default router.post(\"/\", async (req, res) => {\n  const dataList = await u.db(\"o_vendorConfig\").select(\"id\").where(\"enable\", 1);\n  if (!dataList || dataList.length === 0) {\n    return res.status(404).send({ error: \"模型未找到\" });\n  }\n  const data = await Promise.all(\n    dataList.map(async (item) => {\n      const vendor = u.vendor.getVendor(item.id!);\n      const promptList = await u.db(\"o_modelPrompt\").andWhere(\"vendorId\", vendor.id).select(\"*\");\n      const promptMap = new Map(promptList.map((p) => [p.model, { fileName: p.fileName, path: p.path }]));\n      const models = await u.vendor.getModelList(item.id!);\n      const filteredModels = models\n        .filter((m: any) => m.type === \"video\")\n        .map((m: any) => ({\n          name: m.name,\n          type: m.type as \"image\" | \"video\",\n          model: m.modelName,\n          ...(promptMap.get(m.modelName) ? { ...promptMap.get(m.modelName) } : {}),\n        }));\n      return {\n        id: item.id,\n        name: vendor.name,\n        promptList: filteredModels,\n      };\n    }),\n  );\n  res.status(200).send(success(data));\n});\n","embedding":[0.023955505341291428,0.04613933712244034,0.018357016146183014,0.06863763928413391,0.005604094825685024,0.013121752999722958,0.0015794218052178621,0.0685298815369606,0.017122698947787285,0.006642470136284828,-0.007293348666280508,-0.05218565836548805,0.0012234796304255724,-0.03681597858667374,-0.011464674025774002,0.04020107537508011,-0.0293163750320673,-0.06950293481349945,-0.06020050123333931,-0.028816796839237213,0.06494176387786865,0.04425639286637306,0.035730838775634766,0.021428165957331657,-0.032885678112506866,-0.019845379516482353,0.020420093089342117,-0.08696828782558441,-0.037946440279