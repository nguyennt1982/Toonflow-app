{"file":"src/routes/project/getModelDetails.ts","chunks":[{"line":1,"text":"import express from \"express\";\nimport { success, error } from \"@/lib/responseFormat\";\nimport u from \"@/utils\";\nimport { z } from \"zod\";\nimport { validateFields } from \"@/middleware/middleware\";\nconst router = express.Router();\n\nexport default router.post(\n  \"/\",\n  validateFields({\n    key: z.enum([\"scriptAgent\", \"productionAgent\"]),\n  }),\n  async (req, res) => {\n    const { key } = req.body;\n    const data = await u.db(\"o_agentDeploy\").select(\"o_agentDeploy.*\").where(\"o_agentDeploy.key\", key).first();\n    const [id, modelName] = data ? data.modelName.split(/:(.+)/) : [];\n    const models = await u.vendor.getModelList(id);\n    const model = models.find((m) => m.modelName === modelName);\n    if (!model) return res.status(400).send(error(\"未找到模型\"));\n    res.status(200).send(success(model));\n  },\n);\n","embedding":[-0.0372917614877224,0.07099436968564987,0.0026648410130292177,0.04626725614070892,0.044638581573963165,-0.03505677729845047,-0.06777536123991013,0.06677170842885971,0.040829602628946304,0.02267507277429104,-0.01661546342074871,-0.05748908966779709,0.030150601640343666,-0.012720922939479351,-0.011258001439273357,0.058203257620334625,-0.033040206879377365,-0.05670616030693054,-0.0394444540143013,-0.021796924993395805,0.0698213279247284,0.06981376558542252,0.01716051995754242,0.056416355073451996,-0.021243572235107422,-0.09412108361721039,-0.006841817405074835,0.011128165759146214,-0.04520929977297783,-0.0100783072412014,0.016781805083155632,-0.0033805600833147764,-0.0725366547703743,0.04965458810329437,0.04052353277802467,0.05418780818581581,0.0064238435588777065,-0.09645818918943405,0.028806792572140694,-0.0323987640440464,0.014351529069244862,0.03673766553401947,-0.003008591942489147,-0.021266421303153038,0.13799014687538147,-0.05179811269044876,-0.036415304988622665,0.01117780338972807,0.0035338562447577715,-0.02527749538421631,-0.068558163